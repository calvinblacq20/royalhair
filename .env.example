# Copy to .env.production.local (never committed) or set on the host. Names only live in git.

# The live address, https and no trailing slash. Used for link previews (og:url, og:image),
# the canonical link, robots.txt and sitemap.xml. The build stops if it is missing.
VITE_SITE_URL=https://www.example.com

# "on" builds the demo shown to the salon: the salon side (/#/admin), sample data controls and the
# "Demo build" label. Leave it unset for the live site: there are no staff logins until the backend
# exists (docs/decisions/0002-backend-and-hosting.md), so the salon side must not be reachable.
# VITE_SALON_SIDE=on

# Railway sets PORT itself; serve.mjs falls back to 3000 locally.
# PORT=3000
